GEMINI_SERVICE_ENV=development
GEMINI_SERVICE_HOST=0.0.0.0
GEMINI_SERVICE_PORT=8000
GEMINI_SERVICE_LOG_LEVEL=INFO
GEMINI_SERVICE_LOG_JSON=false
GEMINI_SERVICE_REQUIRE_AUTH=true
GEMINI_SERVICE_API_TOKENS=change-me
GEMINI_SERVICE_DATABASE_URL=sqlite+aiosqlite:///./data/gemini_service.db
GEMINI_SERVICE_ACCOUNTS_CONFIG_PATH=config/accounts.json
GEMINI_SERVICE_MIN_READY_ACCOUNTS=1
GEMINI_SERVICE_GLOBAL_MAX_CONCURRENCY=32
GEMINI_SERVICE_GLOBAL_MAX_QUEUE_DEPTH=128
GEMINI_SERVICE_PER_ACCOUNT_MAX_QUEUE_DEPTH=16
GEMINI_SERVICE_QUEUE_WAIT_TIMEOUT_SECONDS=30
GEMINI_SERVICE_ACCOUNT_PROBE_INTERVAL_SECONDS=30
GEMINI_SERVICE_DEFAULT_ACCOUNT_COOLDOWN_SECONDS=60
GEMINI_SERVICE_DEGRADED_FAILURE_THRESHOLD=1
GEMINI_SERVICE_UNAVAILABLE_FAILURE_THRESHOLD=3
GEMINI_SERVICE_RECENT_ERROR_LIMIT=5
GEMINI_SERVICE_UI_USERNAME=admin
GEMINI_SERVICE_UI_PASSWORD=change-me-ui-password
GEMINI_SERVICE_UI_SESSION_SECRET=change-me-session-secret
GEMINI_SERVICE_UI_SESSION_COOKIE=gemini_service_ui
GEMINI_SERVICE_METRICS_ENABLED=true
